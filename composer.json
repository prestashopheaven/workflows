{
    "name": "prestashopheaven/workflows",
    "description": "Reusable GitHub workflows and the monorepo helper of the PrestaHaven package collection (not a Composer package; tests only).",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "files": ["src/Mono.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaHavenMono\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=always tests"
    }
}
